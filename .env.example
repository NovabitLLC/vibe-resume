# Vibe Resume — environment variable template.
# Copy to .env.local and fill in real values. Never commit real keys.

AI_PROVIDER=openai

# OpenAI (default provider)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

